.DS_Store
node_modules/
app/dist/

# Font source assets (large binaries, only sprite.json metadata is tracked)
assets/font-sources/**
!assets/font-sources/**/
!assets/font-sources/**/sprite.json

# Test output (transient renders, not tracked)
tests/output/

# The worktrees used during development symlink node_modules; a trailing
# slash in the pattern above does not match a symlink.
node_modules

# Session state, local by default
.checkpoints/
